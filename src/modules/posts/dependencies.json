{
  "module": "posts",
  "version": "1.0.0",
  "description": "Post management and content publishing module",
  "dependencies": {
    "external": {
      "@prisma/client": "^5.0.0",
      "zod": "^3.22.0"
    },
    "internal": {
      "shared": {
        "services": ["ILogger"],
        "connections": ["relay-core", "pagination"],
        "filtering": ["filter-utils"],
        "database": ["prisma"]
      },
      "auth": {
        "guards": ["requireAuthentication", "hasRole"],
        "client": ["IAuthClient"]
      },
      "users": {
        "client": ["IUsersClient"]
      }
    }
  },
  "provides": {
    "services": ["IPostsService", "IPostsDataRepository"],
    "resolvers": [
      "posts",
      "post",
      "createPost",
      "updatePost",
      "deletePost",
      "publishPost"
    ],
    "types": [
      "Post",
      "PostCreateInput",
      "PostUpdateInput",
      "PostOrderBy",
      "PostWhereInput"
    ],
    "client": "IPostsClient"
  },
  "isolation": {
    "data": {
      "owns": ["Post"],
      "readonly": ["User"],
      "restricted": ["RefreshToken", "VerificationToken", "OIDC*"]
    },
    "communication": {
      "accepts": ["user.deleted", "user.suspended"],
      "publishes": [
        "post.created",
        "post.updated",
        "post.deleted",
        "post.published",
        "post.unpublished",
        "post.viewed",
        "post.moderated"
      ]
    }
  },
  "business_rules": {
    "ownership": "Posts belong to users who created them",
    "publication": "Only post owners or admins can publish/unpublish",
    "deletion": "Only post owners or admins can delete posts",
    "viewing": "Published posts are public, drafts are private"
  },
  "configuration": {
    "required_env_vars": [],
    "optional_env_vars": ["MAX_POST_LENGTH", "DEFAULT_PAGE_SIZE"]
  }
}
